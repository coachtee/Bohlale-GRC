# Bohlale GRC — Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit your real .env file.

# --- Core Django settings ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database ---
# Leave DB_ENGINE=sqlite for local development (default, zero-config).
# Set DB_ENGINE=postgres for staging/production.
DB_ENGINE=sqlite
DB_NAME=bohlale_grc
DB_USER=bohlale
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Security (production) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
# How long a login session stays valid, in seconds (default 604800 = 7 days).
DJANGO_SESSION_COOKIE_AGE=604800
# If True, sessions end when the browser is closed (in addition to the age above).
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# --- Email ---
# Use console backend for local development (prints emails to terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Bohlale GRC <no-reply@bohlalegrc.example>

# --- AI Provider (provider-independent abstraction, see ai/ app) ---
# AI_PROVIDER options: mock | openai_compatible
# "mock" requires no API key and is safe for demos/offline development.
# "openai_compatible" works with OpenAI-compatible endpoints, including
# many Qwen-compatible (e.g. DashScope OpenAI-compatible mode) endpoints —
# just point AI_API_BASE at the relevant compatible endpoint.
AI_PROVIDER=mock
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=25

# --- Docker / Compose deployment (deployment/install.sh, compose.yml) ---
# Only relevant when deploying via Docker; ignored by plain
# `manage.py runserver`. See deployment/README.md for the one-command
# install flow.

# Prefix used for the compose project name, container names and named
# volumes (e.g. "<PROJECT_NAME>_postgres_data"). Change this first when
# reusing this toolkit for another project (Bohlale Learn, Health, Notes).
COMPOSE_PROJECT_NAME=bohlale-grc

# Postgres credentials for the "postgres" container. compose.yml maps
# these onto DB_NAME/DB_USER/DB_PASSWORD/DB_HOST automatically for the
# Django container - you do not need to duplicate them under different
# names. POSTGRES_PASSWORD has no default; the stack refuses to start
# until you set a real one here.
POSTGRES_DB=bohlale_grc
POSTGRES_USER=bohlale
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Host port the app is published on (http://<host>:<WEB_PORT>/).
WEB_PORT=8000

# Docker image name:tag built by `docker compose build`.
IMAGE_NAME=bohlale-grc
IMAGE_TAG=latest

# Pre-existing external Docker network this stack attaches to (e.g. a
# shared reverse proxy in staging). Must already exist -
# deployment/install.sh will offer to create it if it doesn't.
EXTERNAL_NETWORK=bohlale-health-staging_private

# Gunicorn tuning (all optional - sane defaults are used if unset, see
# gunicorn.conf.py). GUNICORN_WORKERS defaults to (2 x CPU cores) + 1.
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=60

# Optional: automatically create a superuser account on first start if
# one with this email doesn't already exist yet (idempotent - safe to
# leave set across restarts/updates). Leave both blank to skip and create
# one manually instead:
#   docker compose exec bohlale-grc python manage.py createsuperuser
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Where deployment/backup.sh writes backups and deployment/restore.sh /
# rollback.sh read them from.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
