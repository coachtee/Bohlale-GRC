# Bohlale GRC — Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# Never commit your real .env file.

# --- Core Django settings ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database ---
# Leave DB_ENGINE=sqlite for local development (default, zero-config).
# Set DB_ENGINE=postgres for staging/production.
DB_ENGINE=sqlite
DB_NAME=bohlale_grc
DB_USER=bohlale
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Security (production) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# --- Email ---
# Use console backend for local development (prints emails to terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Bohlale GRC <no-reply@bohlalegrc.example>

# --- AI Provider (provider-independent abstraction, see ai/ app) ---
# AI_PROVIDER options: mock | openai_compatible
# "mock" requires no API key and is safe for demos/offline development.
# "openai_compatible" works with OpenAI-compatible endpoints, including
# many Qwen-compatible (e.g. DashScope OpenAI-compatible mode) endpoints —
# just point AI_API_BASE at the relevant compatible endpoint.
AI_PROVIDER=mock
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=25
